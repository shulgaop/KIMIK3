                <wpt lat="39.658500" lon="66.957700">
                    <ele>700</ele>
                    <name><![CDATA[🎧 02 Самарканд (отель Sofia)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 02]]></cmt>
                    <desc><![CDATA[Аудиогид трек 02 «Самарканд». День 1 (06.09). Слушать в городе/вечером в отеле.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.495400" lon="67.609500">
                    <ele>1000</ele>
                    <name><![CDATA[🎧 03 Граница, Пенджикент, Артуч (слушать в Пенджикенте)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 03]]></cmt>
                    <desc><![CDATA[Аудиогид трек 03 «Граница, Пенджикент, Сарязм, Артуч». День 2 (07.09). Слушать по прибытии в Пенджикент (точка — центральный базар).]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.495400" lon="67.610500">
                    <ele>1000</ele>
                    <name><![CDATA[🎧 14 История и этнография (Пенджикент)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 14]]></cmt>
                    <desc><![CDATA[Аудиогид трек 14 «История и этнография» — Саразм, согдийцы, ягноби, советское освоение Фанов. День 2 (07.09). Слушать в Пенджикенте или по дороге в Артуч.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.273161" lon="68.136646">
                    <ele>2160</ele>
                    <name><![CDATA[🎧 15 Флора и фауна (Артуч, вечер)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 15]]></cmt>
                    <desc><![CDATA[Аудиогид трек 15 «Флора и фауна» — пояса растительности, арча, теке, сурки, барс, гюрза. День 2 вечером в Артуче — перед стартом трека.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.273200" lon="68.137600">
                    <ele>2160</ele>
                    <name><![CDATA[🎧 04 Артуч — Куликалон (на выходе из Артуча)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 04]]></cmt>
                    <desc><![CDATA[Аудиогид трек 04 «Артуч — Куликалон». День 3 (08.09). Слушать утром на выходе из альплагеря.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.255100" lon="68.172300">
                    <ele>2840</ele>
                    <name><![CDATA[🎧 05 Куликалонский цирк]]></name>
                    <cmt><![CDATA[Аудиогид, трек 05]]></cmt>
                    <desc><![CDATA[Аудиогид трек 05 «Куликалонский цирк». День 3 (08.09). Слушать на берегу Куликалона.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.249100" lon="68.227700">
                    <ele>3860</ele>
                    <name><![CDATA[🎧 06 Перевал Алаудин]]></name>
                    <cmt><![CDATA[Аудиогид, трек 06]]></cmt>
                    <desc><![CDATA[Аудиогид трек 06 «Перевал Алаудин». День 4 (09.09). Слушать у оз. Душаха перед взлётом или на седловине.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.236100" lon="68.254700">
                    <ele>2820</ele>
                    <name><![CDATA[🎧 07 Алауддинские озёра]]></name>
                    <cmt><![CDATA[Аудиогид, трек 07]]></cmt>
                    <desc><![CDATA[Аудиогид трек 07 «Алауддинские озёра». День 4 (09.09). Слушать на берегу у лагеря.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.236600" lon="68.255600">
                    <ele>2820</ele>
                    <name><![CDATA[🎧 13 Геология маршрута (Алауддинские озёра, вечер)]]></name>
                    <cmt><![CDATA[Аудиогид, трек 13]]></cmt>
                    <desc><![CDATA[Аудиогид трек 13 «Геология маршрута» — вы стоите на донной морене древнего ледника. День 4 вечером.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.196000" lon="68.237000">
                    <ele>3520</ele>
                    <name><![CDATA[🎧 08 Мутные озёра]]></name>
                    <cmt><![CDATA[Аудиогид, трек 08]]></cmt>
                    <desc><![CDATA[Аудиогид трек 08 «Мутные озёра». День 5 (10.09). Слушать у озёр, вид на Замок, Энергию, Чимтаргу.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.184900" lon="68.214700">
                    <ele>4105</ele>
                    <name><![CDATA[🎧 09 Лагерь под Чимтаргой]]></name>
                    <cmt><![CDATA[Аудиогид, трек 09]]></cmt>
                    <desc><![CDATA[Аудиогид трек 09 «Лагерь под Чимтаргой». День 6 (11.09). Слушать вечером перед отбоем.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.189200" lon="68.197700">
                    <ele>4740</ele>
                    <name><![CDATA[🎧 10 Перевал Чимтарга]]></name>
                    <cmt><![CDATA[Аудиогид, трек 10]]></cmt>
                    <desc><![CDATA[Аудиогид трек 10 «Перевал Чимтарга». День 7 (12.09). Слушать на седловине (ветер! заранее в наушниках) или накануне вечером.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.210300" lon="68.132100">
                    <ele>3160</ele>
                    <name><![CDATA[🎧 11 Большое Алло]]></name>
                    <cmt><![CDATA[Аудиогид, трек 11]]></cmt>
                    <desc><![CDATA[Аудиогид трек 11 «Большое Алло». Дни 7–8 (12–13.09). Слушать на берегу в днёвку.]]></desc>
                    <sym>Scenic Area</sym>
                </wpt>
                <wpt lat="39.251400" lon="68.038300">
                    <ele>1700</ele>
                    <name><![CDATA[🎧 12 Зиндон, Арчамайдан, Газза]]></name>
                    <cmt><![CDATA[Аудиогид, трек 12]]></cmt>
